# Backend environment variables
# Copy this file to .env and fill in your values before running `npm run dev` or deploying to Render.

PORT=4000
NODE_ENV=development

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ---- Gemini (Primary LLM & Embeddings) ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768

# ---- Groq (Optional Fallback LLM) ----
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ---- Storage limits ----
MAX_SUPABASE_FILE_BYTES=52428800

# ---- CORS ----
# Comma-separated list of allowed frontend origins (e.g. http://localhost:3000,https://your-app.vercel.app)
FRONTEND_ORIGIN=http://localhost:3000
